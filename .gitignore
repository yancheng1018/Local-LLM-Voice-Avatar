# frontend-minimal 构建产物
frontend-minimal/dist/
frontend-minimal/tests/__tsout__/
frontend-minimal/node_modules/

# 通用产物
*.tsbuildinfo

# ---------- 模型资产（体积大，保留本地不入库） ----------
